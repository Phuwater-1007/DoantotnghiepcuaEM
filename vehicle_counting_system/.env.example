# Web and authentication
TRAFFIC_MONITORING_ENV=development
TRAFFIC_MONITORING_SESSION_SECRET=replace-with-a-random-secret
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_MODE=0
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_AUTO_SHUTDOWN=0

# Vehicle detector: the main application accepts TensorRT .engine only
YOLO_WEIGHTS=data/models/yolo11s.engine
DEVICE=cuda:0
USE_GPU=true
USE_HALF=true
YOLO_PRECISION=fp16
CONF_THRESHOLD=0.25
IMAGE_SIZE=960
MIN_BOX_AREA=300
MAX_DETECTIONS=150
NMS_IOU_THRESHOLD=0.45
ALLOWED_CLASSES=motorcycle,car,truck,bus

# Independent analysis pipelines
ENABLE_COUNTING_PIPELINE=true
ENABLE_LPR_PIPELINE=true
LPR_DEBOUNCE_SECONDS=60
LPR_QUALITY_THRESHOLD=0.20

# Web stream
STREAM_MAX_FPS=12
STREAM_OUTPUT_WIDTH=1280
STREAM_RTSP_TRANSPORT=tcp
MAX_CONCURRENT_STREAMS=3

# Tracking
BYTETRACK_ACTIVATION_TH=0.25
BYTETRACK_MATCHING_TH=0.50
BYTETRACK_LOST_BUFFER=120
BYTETRACK_MIN_CONSEC_FRAMES=1
CLASS_SMOOTHING_WINDOW=15
CLASS_SMOOTHING_MIN_VOTES=3

# Runtime and overlay
END_OF_VIDEO_MODE=stop
FORCE_EXIT_ON_SHUTDOWN=true
SKIP_FRAMES=1
SHOW_TRACK_CENTER=true
SHOW_LABELS=true
SHOW_CONFIDENCE=false
SHOW_TRACK_ID=false
SHOW_STATS=true
ROI_MODE=outline
COUNTING_LINE_MODE=soft
